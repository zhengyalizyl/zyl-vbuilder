{
    "name": "zyl-vbuilder",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
       "packageManager": "pnpm@9.5.0",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "dev:builder": "pnpm --filter builder dev",
        "dev:runner": "pnpm --filter runner dev",
        "preview": "turbo run preview",
        "lint:vue": "eslint --fix",
        "lint:style": "stylelint \"{packages,apps}/**/*.{css,scss,vue}\"",
        "lint": "pnpm lint:ts && pnpm lint:style",
        "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md|vue)\"",
        "typecheck": "pnpm --filter builder typecheck ",
        "commit": "git-cz",
        "prepare": "husky",
        "clean": "rimraf \"{apps,packages}/**/{node_modules,docs,lib,dist,stats.html}\" node_modules pnpm-lock.yaml .eslintcache .cspellcache docs dist"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-git"
        }
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,vue}": [
            "eslint --fix",
            "prettier --write --cache"
        ],
        "*.{css,scss,vue}": [
            "stylelint --fix",
            "prettier --cache --write --parser=typescript"
        ]
    },
    "devDependencies": {
        "@zyl-vbuilder/eslint": "workspace:*",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/node": "^26.6.6",
        "@typescript-eslint/parser": "^8.72.1",
        "commitizen": "4.3.2",
        "commitlint": "^21.2.4",
        "cspell": "^10.4.0",
        "cz-git": "^1.14.0",
        "eslint": "^10.14.0",
        "@eslint/js": "^10.0.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "10.6.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "tsconfig": "^7.0.0",
        "typescript": "~5.9.3",
        "vue-eslint-parser": "^10.4.1",
        "rimraf": "6.0.1",
        "turbo": "2.0.9"
    }
}
